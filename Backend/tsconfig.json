{
    "compilerOptions": {
      /* Basic */
      "target": "ES2020",
      "module": "Node16",
      "rootDir": "./src",
      "outDir": "./dist",
      /* Node Resolution */
      "moduleResolution": "Node16",
      "resolveJsonModule": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      /* Type Safety */
      "strict": true,
      "noImplicitAny": false,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      /* Debugging */
      "sourceMap": true,
      /* Performance */
      "incremental": true,
      /* Node types */
      "types": ["node"]
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}